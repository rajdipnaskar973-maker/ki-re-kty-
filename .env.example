# API Keys (get free keys from the providers below)

# OpenRouteService - get a free key at https://openrouteservice.org/dev/#/signup
# Used as fallback routing provider. Not required for basic functionality (OSRM is used by default).
VITE_ORS_API_KEY=

# MapTiler - get a free key at https://cloud.maptiler.com/account/keys/
# Optional: for vector map tiles. The app uses free OpenStreetMap raster tiles by default.
VITE_MAPTILER_KEY=
